{
  "name": "fluxo",
  "description": "Agente padrão do fluxo: as instruções e as skills do fluxo, com os hooks do painel.",
  "prompt": "Siga as instruções do fluxo (steering fluxo.md) e use as skills dele.",
  "tools": [
    "*"
  ],
  "includeMcpJson": true,
  "resources": [
    "file://~/.kiro/steering/fluxo.md",
    "skill://~/.kiro/skills/commitar/SKILL.md",
    "skill://~/.kiro/skills/concluir/SKILL.md",
    "skill://~/.kiro/skills/implementar/SKILL.md",
    "skill://~/.kiro/skills/pesquisar/SKILL.md",
    "skill://~/.kiro/skills/planejar/SKILL.md",
    "skill://~/.kiro/skills/pr-feedback/SKILL.md",
    "skill://~/.kiro/skills/revisar/SKILL.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "\"$HOME/.local/bin/fluxo\" hook --tool kiro --event agentSpawn || true"
      }
    ],
    "userPromptSubmit": [
      {
        "command": "\"$HOME/.local/bin/fluxo\" hook --tool kiro --event userPromptSubmit || true"
      }
    ],
    "postToolUse": [
      {
        "command": "\"$HOME/.local/bin/fluxo\" hook --tool kiro --event postToolUse || true",
        "matcher": "*"
      }
    ],
    "stop": [
      {
        "command": "\"$HOME/.local/bin/fluxo\" hook --tool kiro --event stop || true"
      }
    ]
  }
}
