{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event sessionStart",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event userPromptSubmitted",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event postToolUse",
        "timeoutSec": 5
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event postToolUseFailure",
        "timeoutSec": 5
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event notification",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event subagentStart",
        "timeoutSec": 5
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event subagentStop",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event agentStop",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "\"$HOME/.local/bin/fluxo\" hook --tool copilot --event sessionEnd",
        "timeoutSec": 5
      }
    ]
  }
}
